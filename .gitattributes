# Keep the repo's canonical line endings at LF so gofmt (and CI) agree with
# the committed files regardless of a contributor's core.autocrlf setting.
* text=auto
*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.html text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
