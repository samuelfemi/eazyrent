# Copy to .env and adjust. Taskfile loads .env automatically.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/easyrent?sslmode=disable
ADDR=:8080
# 32+ random bytes for HS256 access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
ACCESS_TOKEN_SECRET=change-me-to-32-or-more-random-bytes
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30
# Brevo (https://app.brevo.com/settings/keys/api). Sender address must be a
# verified Brevo sender: https://app.brevo.com/settings/senders.
BREVO_API_KEY=xkeysib-your-key-here
EMAIL_FROM=EasyRent <noreply@yourdomain.com>
APP_URL=http://localhost:8080
# Web app origin used for links inside emails (verify / reset-password).
FRONTEND_URL=http://localhost:3000
